---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { title, description, type = 'website', noindex = false, jsonLd } = Astro.props;
const site = Astro.site ?? new URL('https://madhan.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL('/og-image.jpg', site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content="Madhan Kumar R" />
    <meta name="theme-color" content="#f5f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10171c" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content="Madhan Kumar R" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Madhan Kumar R, Senior Backend Engineer" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --paper: #f5f6f3;
    --surface: #ffffff;
    --ink: #142028;
    --muted: #56636c;
    --rule: #d6dbd6;
    --chip: #8a6416;       /* card-chip gold: links, accents, decisions */
    --chip-soft: #e9dcbc;
    --settled: #2b6a4a;    /* success / live */
    --settled-soft: #e4f0e8;
    --late: #9a4a2f;       /* failure / recovery path */
    --late-soft: #fbf4f1;
    --guard: #1e3a5f;      /* safeguards */
    --guard-soft: #eef2f7;
    --tab-track: #e8ebe7;
    --measure: 68ch;
    --sans: 'Schibsted Grotesk', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #10171c;
      --surface: #172128;
      --ink: #e8ece8;
      --muted: #9aa6ad;
      --rule: #2a363e;
      --chip: #d9b25e;
      --chip-soft: #3a3220;
      --settled: #6fc196;
      --settled-soft: #1b3326;
      --late: #e0906f;
      --late-soft: #2a1c17;
      --guard: #8fb3e0;
      --guard-soft: #182634;
      --tab-track: #1e2a31;
      color-scheme: dark;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  a:hover { color: var(--chip); }
  :focus-visible { outline: 2px solid var(--chip); outline-offset: 3px; border-radius: 4px; }
  h1, h2, h3 { line-height: 1.15; margin: 0; }
  p { margin: 0; }
  ul, ol, dl, dd { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  img { max-width: 100%; display: block; }
  .wrap { width: min(1080px, 100% - 2.5rem); margin-inline: auto; }
  .skip { position: absolute; left: -999px; top: 0; padding: 0.6rem 1rem; background: var(--ink); color: var(--paper); z-index: 10; }
  .skip:focus { left: 1rem; top: 1rem; }

  /* shared pieces */
  .section { padding-block: 3.5rem; border-top: 1px solid var(--rule); }
  .section-title { font-size: clamp(1.7rem, 2.6vw, 2.1rem); font-weight: 700; letter-spacing: -0.02em; }
  .lede { color: var(--muted); margin-top: 0.6rem; max-width: var(--measure); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 1.15rem; border-radius: 999px;
    border: 1px solid var(--rule); background: var(--surface); color: var(--ink);
    text-decoration: none; font-weight: 600; font-size: 0.95rem;
  }
  .btn:hover { border-color: var(--ink); color: var(--ink); }
  .btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn.primary:hover { background: var(--chip); border-color: var(--chip); color: var(--paper); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (max-width: 700px) {
    .section { padding-block: 2.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
