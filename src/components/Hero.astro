---
import { Image } from 'astro:assets';
import portrait from '../assets/madhan-portrait.jpg';
import { profile, coreSkills, integrations } from '../data/profile';
---
<section class="hero wrap">
  <div class="text">
    <div class="who">
      <Image src={portrait} alt={profile.name} width={84} height={84} densities={[1, 2]} loading="eager" fetchpriority="high" />
      <div>
        <p class="name">{profile.name}</p>
        <p class="role">{profile.role}, based in {profile.location}</p>
      </div>
    </div>
    <h1>{profile.headline}</h1>
    <ul class="chips" aria-label="Core skills">
      {coreSkills.stack.map((s) => <li class="dark">{s}</li>)}
      {coreSkills.domain.map((s) => <li>{s}</li>)}
    </ul>
    <p class="years">{profile.experienceLine}</p>
    <div class="actions">
      <a class="btn primary" href={profile.resume} download>Download resume</a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>

  <figure class="card" aria-labelledby="int-cap">
    <div class="card-head">
      <code>integrations shipped</code>
      <span>banking and payments</span>
    </div>
    <ul class="rail">
      {integrations.map((row, i) => (
        <li style={`--i:${i}`}>
          <span class="node" aria-hidden="true"></span>
          <span class="group">{row.group}</span>
          <span class="items">{row.items}</span>
        </li>
      ))}
    </ul>
    <figcaption id="int-cap">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><circle cx="9" cy="9" r="9" fill="currentColor"></circle><path d="M5 9.2l2.6 2.6L13 6.4" fill="none" stroke="var(--surface)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      Live in production at a major UAE bank and a payment gateway
    </figcaption>
  </figure>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: 3.5rem; align-items: center; padding-block: 4rem 4.5rem; }
  .text { flex: 1 1 460px; min-width: 0; }
  .who { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .who :global(img) { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 3px solid var(--surface); box-shadow: 0 0 0 1px var(--rule); }
  .name { font-weight: 700; font-size: 1.05rem; }
  .role { color: var(--muted); font-size: 0.95rem; }
  h1 { font-size: clamp(2.3rem, 4.6vw, 3.6rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; max-width: 16ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.75rem; max-width: 560px; }
  .chips li { padding: 0.35rem 0.85rem; border-radius: 999px; border: 1px solid var(--rule); background: var(--surface); font-size: 0.95rem; font-weight: 600; }
  .chips li.dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .years { margin-top: 1rem; color: var(--muted); font-size: 0.95rem; }
  .actions { margin-top: 2rem; }

  .card { flex: 1 1 400px; min-width: 0; margin: 0; background: var(--surface); border: 1px solid var(--rule); border-radius: 14px; padding: 1.5rem 1.5rem 1.25rem; position: relative; overflow: hidden; }
  .card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: linear-gradient(90deg, var(--chip) 0 38%, var(--chip-soft) 38% 100%); }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; font-size: 0.875rem; color: var(--muted); }
  code { font-family: var(--mono); color: var(--ink); }
  .rail { position: relative; display: grid; gap: 1.1rem; }
  .rail::before { content: ''; position: absolute; left: 7px; top: 10px; bottom: 10px; width: 2px; background: var(--rule); transform-origin: top; animation: grow 0.9s ease-out 0.3s both; }
  .rail li { display: grid; grid-template-columns: 16px 7.5rem 1fr; gap: 0.75rem; align-items: center; position: relative; }
  .node { width: 16px; height: 16px; border-radius: 50%; background: var(--settled); position: relative; z-index: 1; animation: pop 0.35s ease-out calc(0.35s + var(--i) * 0.3s) both; }
  .group { font-weight: 600; font-size: 0.95rem; }
  .items { color: var(--muted); font-size: 0.95rem; }
  figcaption { margin-top: 1.4rem; padding-top: 1rem; border-top: 1px dashed var(--rule); display: flex; align-items: center; gap: 0.6rem; color: var(--settled); font-weight: 600; animation: fade 0.4s ease-out 1.3s both; }
  @keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes pop { from { transform: scale(0.3); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  @media (max-width: 860px) { .hero { padding-block: 2rem 3rem; gap: 2.5rem; } }
  @media (max-width: 520px) {
    .rail li { grid-template-columns: 16px 1fr; row-gap: 0.1rem; align-items: start; }
    .node { margin-top: 4px; }
    .items { grid-column: 2; font-size: 0.9rem; }
    .who :global(img) { width: 68px; height: 68px; }
  }
</style>
