---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found — Madhan Kumar R"
  description="This page doesn't exist on madhan.dev."
  noindex
>
  <section class="wrap nf">
    <div class="event" aria-hidden="true">
      <code>page.request</code>
      <div class="rail">
        <span class="box">You</span>
        <span class="line"></span>
        <span class="box miss">This page</span>
      </div>
      <p class="status">404 · not found</p>
    </div>

    <h1>This page doesn't exist.</h1>
    <p class="lede">The link may be old, or the address may have a typo. Everything on the site is one click from the home page.</p>
    <div class="actions">
      <a class="btn primary" href="/">Go to the home page</a>
      <a class="btn" href="/case-studies/card-delivery/">Read a case study</a>
      <a class="btn" href="/#contact">Contact me</a>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: 4.5rem 6rem; }
  .nf h1, .nf .lede { max-width: 760px; }
  .event {
    display: inline-flex; flex-direction: column; gap: 0.9rem;
    padding: 1.25rem 1.5rem; margin-bottom: 2.5rem;
    background: var(--late-soft); border: 1px dashed var(--late); border-radius: 14px;
  }
  code { font-family: var(--mono); font-size: 0.875rem; color: var(--ink); }
  .rail { display: flex; align-items: center; gap: 0.75rem; }
  .box { padding: 0.4rem 0.8rem; border-radius: 8px; background: var(--surface); border: 1px solid var(--rule); font-weight: 600; font-size: 0.95rem; }
  .box.miss { border: 1px dashed var(--late); color: var(--late); }
  .line { width: 64px; border-top: 2px dashed var(--late); }
  .status { font-family: var(--mono); font-size: 0.875rem; font-weight: 500; color: var(--late); }
  h1 { font-size: clamp(2.2rem, 4.6vw, 3.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; }
  .lede { font-size: 1.1rem; }
  .actions { margin-top: 2rem; }
  @media (max-width: 520px) { .nf { padding-block: 2.5rem 4rem; } }
</style>
